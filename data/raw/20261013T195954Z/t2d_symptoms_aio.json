        "type": "paragraph",
        "snippet": "Type 2 diabetes often develops slowly and silently, meaning many people have no noticeable symptoms in the early stages.",
        "snippet_highlighted_words": [
          "no noticeable symptoms"
        ],
        "reference_indexes": [
