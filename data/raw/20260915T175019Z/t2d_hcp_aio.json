    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Metformin remains the standard first-line medication for type 2 diabetes, but guidelines recommend adding or prioritizing SGLT2 inhibitors or GLP-1 receptor agonists early based on specific patient health needs and organ protection.",
        "snippet_highlighted_words": [
          "guidelines recommend adding or prioritizing SGLT2 inhibitors or GLP-1 receptor agonists early based on specific patient health needs and organ protection"
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Both drug classes lower blood sugar, but they work differently and offer distinct clinical advantages. Choosing between an SGLT2 inhibitor and a GLP-1 receptor agonist depends on your specific health profile, medical history, and treatment goals."
      },
      {
        "type": "heading",
        "snippet": "Key Differences at a Glance"
      },
