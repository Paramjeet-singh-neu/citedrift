    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "ACE inhibitors and ARBs (angiotensin receptor blockers) are both considered first-line medications for treating hypertension, but ARBs generally have a better safety and tolerance profile because they rarely cause the persistent dry cough or angioedema associated with ACE inhibitors.",
        "snippet_highlighted_words": [
          "ARBs generally have a better safety and tolerance profile because they rarely cause the persistent dry cough or angioedema associated with ACE inhibitors."
        ],
        "reference_indexes": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      {
        "type": "heading",
        "snippet": "Key Comparison"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Efficacy: Both classes lower blood pressure effectively and offer similar cardiovascular and kidney-protective benefits.",
            "reference_indexes": [
              2,
              5
            ]
          },
          {
            "snippet": "Side Effects (ACE Inhibitors): Frequently cause a nagging, dry cough (due to bradykinin buildup) and carry a small risk of serious swelling called angioedema.",
            "reference_indexes": [
              3,
              4
            ]
          },
          {
            "snippet": "Side Effects (ARBs): Block the receptor directly without affecting bradykinin, meaning they rarely cause a cough and have a lower incidence of angioedema.",
            "reference_indexes": [
              3,
              4
            ]
          },
          {
            "snippet": "Cost & Availability: While ACE inhibitors have historically been cheaper as generics, most major ARBs (like losartan and valsartan) are now generic and comparably priced.",
            "reference_indexes": [
              6
            ]
          },
          {
            "snippet": "Important Safety Warnings: Neither drug should be used during pregnancy due to the risk of birth defects, and they should never be taken together as a combination therapy due to high risks of severe kidney injury and high potassium levels."
          }
        ],
        "reference_indexes": [
          0,
          7
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you want, tell me:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Are you experiencing side effects from a current medication?"
          },
          {
            "snippet": "Do you have kidney disease or diabetes?"
          }
