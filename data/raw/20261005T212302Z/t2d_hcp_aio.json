      },
      {
        "type": "heading",
        "snippet": "\ud83d\udcca Comparison of SGLT2 Inhibitors vs. GLP-1 Receptor Agonists"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "\ud83d\udc8a Administration",
            "list": [
              {
                "snippet": "SGLT2 inhibitors: Taken orally once daily (pill)."
              },
              {
                "snippet": "GLP-1 RAs: Usually injected weekly or daily (some oral options exist)."
              }
            ]
          },
          {
            "snippet": "\ud83e\udec0 Heart Failure & Kidneys",
            "list": [
              {
                "snippet": "SGLT2 inhibitors: Superior for reducing heart failure hospitalizations and slowing chronic kidney disease progression ."
              },
              {
                "snippet": "GLP-1 RAs: Provide moderate heart/kidney protection, but less than SGLT2 inhibitors."
              }
            ],
            "reference_indexes": [
              2,
              3,
              4,
              5
            ]
          },
          {
            "snippet": "\u2696\ufe0f Weight & Glucose",
            "list": [
              {
                "snippet": "SGLT2 inhibitors: Moderate weight loss and blood sugar reduction."
              },
              {
                "snippet": "GLP-1 RAs: Superior weight loss and strong blood sugar reduction."
              }
            ],
            "reference_indexes": [
              2
            ]
          },
          {
            "snippet": "\ud83d\udcb0 Cost & Access",
            "list": [
              {
                "snippet": "SGLT2 inhibitors: Generally more affordable brand/generic options."
              },
              {
                "snippet": "GLP-1 RAs: Significantly higher cost and frequent supply shortages."
              }
            ]
          }
        ],
        "reference_indexes": [
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83d\udca1 Clinical Decision Framework"
