      {
        "type": "heading",
        "snippet": "\ud83d\udccc Choosing Based on Patient Profile"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "\u2705 Prioritize SGLT2 Inhibitors if:",
            "list": [
              {
                "snippet": "You have diagnosed heart failure (with reduced or preserved ejection fraction) ."
              },
              {
                "snippet": "You have chronic kidney disease (CKD) or diabetic nephropathy."
              },
              {
                "snippet": "You strongly prefer taking an oral daily pill over an injection."
              }
            ]
          },
          {
            "snippet": "\u2705 Prioritize GLP-1 Receptor Agonists if:",
            "list": [
              {
                "snippet": "Significant weight loss or obesity management is a primary goal ."
              },
              {
                "snippet": "You need a greater reduction in blood glucose or A1C."
              },
              {
                "snippet": "You have established atherosclerotic cardiovascular disease or high stroke risk."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
