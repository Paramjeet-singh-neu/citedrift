  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Treatment for hypertension includes lifestyle changes and prescription medications tailored to individual health needs.",
        "snippet_highlighted_words": [
          "lifestyle changes and prescription medications"
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifestyle Changes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Diet: Eat a low-sodium, plant-forward diet or follow the DASH diet (Dietary Approaches to Stop Hypertension) to help lower blood pressure.",
            "snippet_links": [
              {
                "text": "DASH diet",
                "link": "https://www.nhlbi.nih.gov/education/dash-eating-plan"
              }
            ]
          },
          {
            "snippet": "Exercise: Engage in regular aerobic and resistance physical activity."
          },
          {
            "snippet": "Weight: Lose excess weight, as even modest weight reduction improves blood pressure."
          },
          {
            "snippet": "Habits: Limit alcohol intake and stop smoking."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "First-Line Medications"
      },
      {
        "type": "paragraph",
        "snippet": "Doctors often prescribe one or more of these common drug classes:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Thiazide diuretics: Water pills that help the body remove extra sodium and water."
          },
          {
            "snippet": "Calcium channel blockers: Drugs that prevent calcium from entering muscle cells to relax blood vessels."
          },
          {
            "snippet": "ACE inhibitors: Medications that stop the formation of a chemical that narrows blood vessels."
          },
          {
            "snippet": "ARBs (Angiotensin II receptor blockers): Medications that block the action of chemicals that narrow blood vessels."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Additional and Combination Options"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Beta-blockers: Drugs that slow the heart rate and reduce the force of heart contractions, often used if you have a history of heart disease."
          },
          {
            "snippet": "Combination therapy: Many people require two or more blood pressure medications from different classes\u2014sometimes in a single pill\u2014to reach their target blood pressure."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Consult a healthcare provider to determine the safest and most effective treatment plan for your specific blood pressure levels and underlying health conditions."
      }
    ],
