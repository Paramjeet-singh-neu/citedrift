    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Jardiance (empagliflozin) can cause both common and serious side effects.",
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Urinary tract infections (UTIs): Symptoms include burning, urgency, frequency, and cloudy or abnormal urine.",
            "reference_indexes": [
              1
            ]
          },
          {
            "snippet": "Genital yeast infections: Symptoms include itching, burning, pain, swelling, and thick white discharge (in women) or skin redness/irritation (in men).",
            "reference_indexes": [
              1,
              2
            ]
          },
          {
            "snippet": "Increased urination and thirst: Passing more urine (especially at night) and feeling extra thirsty as the kidneys clear out blood sugar.",
            "reference_indexes": [
              0
            ]
          },
          {
            "snippet": "Dehydration and dizziness: Fluid loss can cause low blood pressure, lightheadedness, or fainting when standing up.",
            "reference_indexes": [
              3
            ]
          },
          {
            "snippet": "Other mild effects: Nausea, joint pain, weight loss, or increased cholesterol."
          },
          {
            "snippet": "Diabetic ketoacidosis (DKA): A dangerous buildup of acid in the blood, even when blood sugar is not very high. Signs include nausea, vomiting, stomach pain, fruity-smelling breath, fatigue, and trouble breathing ."
          },
          {
            "snippet": "Severe kidney or urinary infections: Pyelonephritis or urosepsis, marked by high fever, chills, back pain, and bloody or dark urine."
          },
          {
            "snippet": "Necrotizing fasciitis (Fournier's gangrene): A rare, life-threatening bacterial infection of the tissue under the skin in the genital or perineal area."
          },
          {
            "snippet": "Low blood sugar (Hypoglycemia): More likely if Jardiance is taken with other diabetes medications like insulin or sulfonylureas."
          },
          {
            "snippet": "Lower limb amputations: An increased risk reported with SGLT2 inhibitors, particularly for patients with foot ulcers or peripheral artery disease."
          },
          {
            "snippet": "Serious allergic reactions: Rash, hives, or swelling of the face, lips, tongue, and throat."
          }
        ],
        "reference_indexes": [
          4,
          0,
          1,
          5,
          6,
          7,
          8,
          9
        ]
      },
