    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Common and serious side effects of losartan (an angiotensin II receptor blocker used for high blood pressure and kidney protection) include:",
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Dizziness or lightheadedness (especially when standing up quickly)"
          },
          {
            "snippet": "Fatigue or unusual tiredness"
          },
          {
            "snippet": "Upper respiratory tract infections (cold-like symptoms, sore throat)"
          },
          {
            "snippet": "Nasal congestion or stuffy nose"
          },
          {
            "snippet": "Back pain or joint/muscle aches"
          },
          {
            "snippet": "Digestive issues (nausea, vomiting, or diarrhea)"
          },
          {
            "snippet": "Angioedema: Severe, life-threatening swelling of the face, lips, tongue, throat, or mouth."
          },
          {
            "snippet": "Hyperkalemia (High Potassium): Can cause muscle weakness, fatigue, numbness, or an irregular/pounding heartbeat."
          },
          {
            "snippet": "Kidney Problems: Signs include a dramatic decrease in urination, swelling in the feet, ankles, or hands, or unexplained fatigue."
          },
          {
            "snippet": "Severe Low Blood Pressure (Hypotension): Fainting, severe dizziness, confusion, or blurred vision."
          },
          {
            "snippet": "Fetal Harm: Losartan must be avoided during pregnancy as it can cause injury or death to an unborn baby."
          }
        ],
        "reference_indexes": [
          2,
          3,
          4,
          5,
          2,
          3,
          5,
          6,
          7
        ]
      },
