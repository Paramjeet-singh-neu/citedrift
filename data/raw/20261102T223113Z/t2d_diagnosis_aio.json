    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Type 2 diabetes is diagnosed using specific blood tests that measure your blood sugar levels or average blood glucose over time . Doctors usually require the test results to be confirmed on a second day unless clear symptoms are present.",
        "snippet_links": [
          {
            "text": "using specific blood tests that measure your blood sugar levels or average blood glucose over time",
            "link": "https://www.youtube.com/watch?v=pAb0Odjj5xE"
          }
        ],
        "snippet_highlighted_words": [
          "using specific blood tests that measure your blood sugar levels or average blood glucose over time"
        ],
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "Key Diagnostic Blood Tests"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Hemoglobin A1c (HbA1c) Test: Measures your average blood sugar level over the past 2 to 3 months.",
            "list": [
              {
                "snippet": "Diagnostic result: 6.5% or higher confirms diabetes.",
                "reference_indexes": [
                  2,
                  3
                ]
              }
            ],
            "reference_indexes": [
              2,
              3
            ]
          },
          {
            "snippet": "Fasting Plasma Glucose (FPG) Test: Measures your blood sugar after you have not eaten or drank anything except water for at least 8 hours.",
            "list": [
              {
                "snippet": "Diagnostic result: 126 mg/dL or higher confirms diabetes.",
                "reference_indexes": [
                  0,
                  4
                ]
              }
            ],
            "reference_indexes": [
              0,
              4
            ]
          },
          {
            "snippet": "2-Hour Oral Glucose Tolerance Test (OGTT): Measures your blood sugar before and 2 hours after you drink a special sugary liquid.",
            "list": [
              {
                "snippet": "Diagnostic result: 200 mg/dL or higher confirms diabetes.",
                "reference_indexes": [
                  2,
                  4
                ]
              }
            ],
            "reference_indexes": [
              2,
              4
            ]
          },
          {
            "snippet": "Random Plasma Glucose Test: Measures your blood sugar at any time of day, regardless of when you last ate, paired with classic diabetes symptoms (such as extreme thirst, frequent urination, or unexplained weight loss).",
            "list": [
              {
                "snippet": "Diagnostic result: 200 mg/dL or higher confirms diabetes.",
                "reference_indexes": [
                  2
                ]
              }
            ],
            "reference_indexes": [
              2
            ]
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Confirmation and Distinction"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Repeat Testing: Except in cases with severe, classic symptoms and a high random blood sugar reading, doctors typically repeat the diagnostic test on a different day to confirm the results.",
            "reference_indexes": [
              0,
              1
            ]
          },
          {
            "snippet": "Distinguishing Type 2 from Type 1: Because type 1 diabetes and type 2 diabetes are treated differently, your doctor may occasionally order additional bloodwork\u2014such as checking for autoantibodies or C-peptide levels\u2014if it is unclear which type you have.",
            "reference_indexes": [
              2
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "You can learn more about risk factors and lifestyle steps on the Centers for Disease Control and Prevention .",
        "snippet_links": [
          {
            "text": "Centers for Disease Control and Prevention",
            "link": "https://www.cdc.gov/diabetes/about/about-type-2-diabetes.html"
          }
        ],
        "reference_indexes": [
          5
        ]
      },
      {
        "type": "paragraph",
        "snippet": "To help narrow this down:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Are you or someone else experiencing specific symptoms like frequent thirst or fatigue?"
          },
          {
            "snippet": "Was a routine blood test already done that showed high numbers?"
          }
        ]
      }
    ],
