  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Metformin remains the traditional first-line treatment for type 2 diabetes, but modern clinical guidelines recommend choosing either an SGLT2 inhibitor or a GLP-1 receptor agonist early based on your specific health needs and organ protection goals.",
        "snippet_highlighted_words": [
          "modern clinical guidelines recommend choosing either an SGLT2 inhibitor or a GLP-1 receptor agonist early based on your specific health needs and organ protection goals"
        ]
      },
      {
        "type": "paragraph",
        "snippet": "While both classes lower blood sugar, they work differently and suit different patient profiles. You can compare more details about these options on GoodRx .",
        "snippet_links": [
          {
            "text": "GoodRx",
            "link": "https://www.goodrx.com/conditions/diabetes-type-2/glp-1-vs-sglt2"
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "SGLT2 Inhibitors"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How they work: Taken as a daily oral pill, they help your kidneys remove extra sugar through your urine."
          },
          {
            "snippet": "Best for: Patients who also have heart failure or chronic kidney disease (CKD). They slow kidney disease progression and prevent heart failure hospitalizations."
          },
          {
            "snippet": "A1C reduction: Lowers A1C by about 0.5% to 1.0%."
          },
          {
            "snippet": "Weight change: Modest weight loss (1 to 3 kg)."
          },
          {
            "snippet": "Main side effects: Higher risk of urinary tract infections or genital yeast infections."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "GLP-1 Receptor Agonists"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How they work: Most are weekly or daily injections, though some oral options exist. They mimic a natural gut hormone to release insulin and slow digestion."
          },
          {
            "snippet": "Best for: Patients focused on weight loss or lowering the risk of heart attacks and strokes (atherosclerotic cardiovascular disease)."
          },
          {
            "snippet": "A1C reduction: Lowers A1C by up to 1.5% to 2.0% in many studies."
          },
          {
            "snippet": "Weight change: Greater weight loss (4 to 6 kg)."
          },
          {
            "snippet": "Main side effects: Stomach upset, nausea, vomiting, or diarrhea."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "To help me provide more tailored information, could you share:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Do you have any other conditions like heart disease , heart failure, or kidney issues?"
          },
          {
            "snippet": "Is weight loss a primary goal for you?"
          },
          {
            "snippet": "Do you have a strong preference between a daily pill or an injection?"
          }
        ]
      }
    ],
