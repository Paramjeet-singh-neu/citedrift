  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Treatment for type 2 diabetes involves managing blood glucose levels through healthy lifestyle changes, oral or injectable medications, and regular monitoring.",
        "snippet_highlighted_words": [
          "oral or injectable medications"
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifestyle Changes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Healthy diet: Focus on whole grains, lean proteins, non-starchy vegetables, and healthy fats while reducing high-sugar foods and refined carbs."
          },
          {
            "snippet": "Regular exercise: Aim for at least 30 minutes of physical activity daily to help lower blood sugar and promote weight loss."
          },
          {
            "snippet": "Weight management: Reaching and maintaining a healthy weight improves the body's response to insulin."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Medications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Metformin: The most common first-line oral medication, which decreases glucose production in the liver and improves insulin sensitivity.",
            "snippet_links": [
              {
                "text": "Metformin",
                "link": "https://www.mayoclinic.org/diseases-conditions/type-2-diabetes/diagnosis-treatment/drc-20351199"
              }
            ]
          },
          {
            "snippet": "Other oral medications: Includes sulfonylureas (boost insulin production), DPP-4 inhibitors, SGLT2 inhibitors (help excrete sugar via urine), and thiazolidinediones."
          },
          {
            "snippet": "Injectable medications: Includes GLP-1 receptor agonists (which also help with weight management and heart health).",
            "snippet_links": [
              {
                "text": "GLP-1 receptor agonists",
                "link": "https://my.clevelandclinic.org/health/diseases/21501-type-2-diabetes"
              }
            ]
          },
          {
            "snippet": "Insulin therapy: Used when other medications and lifestyle habits do not sufficiently control blood sugar. It can be administered via pens, syringes, or pumps."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Monitoring and Management"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Blood glucose tracking: Checking levels regularly using a standard glucometer or a continuous glucose monitor (CGM)."
          },
          {
            "snippet": "Coexisting conditions: Managing blood pressure and cholesterol levels to prevent long-term cardiovascular and kidney complications."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you'd like, let me know:"
      },
