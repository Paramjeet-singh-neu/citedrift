  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Metformin remains the standard first-line medication for type 2 diabetes, but guidelines recommend SGLT2 inhibitors or GLP-1 receptor agonists early on\u2014or even first-line\u2014based on specific patient health needs and organ protection.",
        "snippet_highlighted_words": [
          "guidelines recommend SGLT2 inhibitors or GLP-1 receptor agonists early on\u2014or even first-line\u2014based on specific patient health needs and organ protection"
        ]
      },
      {
        "type": "heading",
        "snippet": "Key Differences and Selection"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Heart Failure & Kidney Disease: SGLT2 inhibitors (such as empagliflozin) are preferred if you have heart failure or chronic kidney disease, as they protect heart and kidney function ."
          },
          {
            "snippet": "Weight Loss & Blood Sugar: GLP-1 receptor agonists (such as semaglutide) promote greater weight loss and yield a more significant reduction in HbA1c levels."
          },
          {
            "snippet": "Administration: SGLT2 inhibitors are daily oral pills, whereas most GLP-1 receptor agonists are weekly or daily injections (though oral options exist)."
          },
          {
            "snippet": "Side Effects: GLP-1s commonly cause gastrointestinal issues like nausea, while SGLT2 inhibitors carry a higher risk of urinary tract or genital fungal infections."
          }
        ]
      },
      {
