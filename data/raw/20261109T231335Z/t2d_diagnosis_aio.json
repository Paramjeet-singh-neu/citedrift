    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Type 2 diabetes is diagnosed using specific blood tests ordered by a doctor to measure blood sugar levels. Unless a person has clear symptoms of high blood sugar, doctors typically repeat the test on a second day to confirm the diagnosis.",
        "snippet_highlighted_words": [
          "using specific blood tests ordered by a doctor to measure blood sugar levels"
        ],
        "reference_indexes": [
          0,
          1,
          2,
          3
        ]
      },
      {
        "type": "heading",
        "snippet": "Key Blood Tests for Diagnosis"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Hemoglobin A1c (HbA1c) Test: Measures your average blood sugar level over the past 2 to 3 months.",
            "list": [
              {
                "snippet": "Diabetes range: 6.5% or higher"
              },
              {
                "snippet": "Note: Does not require fasting.",
                "reference_indexes": [
                  4,
                  5,
                  6
                ]
              }
            ],
            "reference_indexes": [
              4,
              5,
              6
            ]
          },
          {
            "snippet": "Fasting Plasma Glucose (FPG) Test: Measures your blood sugar after you have had nothing to eat or drink (except water) for at least 8 hours.",
            "list": [
              {
                "snippet": "Diabetes range: 126 mg/dL (7.0 mmol/L) or higher",
                "reference_indexes": [
                  0,
                  1,
                  6
                ]
              }
            ],
            "reference_indexes": [
              0,
              1,
              6
            ]
          },
          {
            "snippet": "Oral Glucose Tolerance Test (OGTT): Measures your blood sugar before and 2 hours after you drink a special sugary liquid (after an 8-hour fast).",
            "list": [
              {
                "snippet": "Diabetes range: 200 mg/dL (11.1 mmol/L) or higher at the 2-hour mark.",
                "reference_indexes": [
                  0,
                  1,
                  6
                ]
              }
            ],
            "reference_indexes": [
              0,
              1,
              6
            ]
          },
          {
            "snippet": "Random Plasma Glucose Test: Measures your blood sugar at any time of day, regardless of when you last ate.",
            "list": [
              {
                "snippet": "Diabetes range: 200 mg/dL or higher, if accompanied by classic symptoms of high blood sugar (such as extreme thirst, frequent urination, unexplained weight loss, or blurred vision).",
                "reference_indexes": [
                  0,
                  3,
                  6
                ]
              }
            ],
            "reference_indexes": [
              0,
              3,
              6
            ]
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Screening Recommendations"
      },
      {
        "type": "paragraph",
        "snippet": "Major health organizations (such as the American Diabetes Association) recommend routine screening for Type 2 diabetes:",
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Adults aged 35 and older"
          },
          {
            "snippet": "Adults of any age who are overweight or obese and have additional risk factors (such as a family history of diabetes, high blood pressure, or a history of gestational diabetes).",
            "reference_indexes": [
              2,
              7
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "You can learn more about managing risk factors and guidance on the Centers for Disease Control and Prevention .",
        "snippet_links": [
          {
            "text": "Centers for Disease Control and Prevention",
            "link": "https://www.cdc.gov/diabetes/signs-symptoms/coping-with-type-2-diagnosis.html"
          }
        ],
        "reference_indexes": [
          8
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Are you asking because you or someone you know recently had blood work done, or are you experiencing specific symptoms like increased thirst or fatigue?"
      }
    ],
