  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Losartan (commonly known by its brand name, Cozaar) is an angiotensin II receptor blocker (ARB) used to treat high blood pressure, reduce stroke risk, and protect the kidneys in people with type 2 diabetes.",
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "Common Side Effects"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Dizziness or lightheadedness (especially when standing up quickly as your body adjusts to lower blood pressure)"
          },
          {
            "snippet": "Upper respiratory infections or \"colds\" / stuffy nose"
          },
          {
            "snippet": "Fatigue or weakness (asthenia)"
          },
          {
            "snippet": "Back pain or joint pain"
          },
          {
            "snippet": "Diarrhea or mild stomach upset / heartburn"
          },
          {
            "snippet": "Low blood sugar (hypoglycemia)"
          }
        ],
        "reference_indexes": [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      },
      {
        "type": "heading",
        "snippet": "Serious Side Effects (Seek Medical Attention)"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Allergic reactions (Angioedema): Sudden swelling of the face, lips, tongue, or throat, which can make it hard to breathe or swallow (requires emergency care immediately) .",
            "reference_indexes": [
              2,
              7
            ]
          },
          {
            "snippet": "Low blood pressure (Hypotension): Feeling faint, dizzy, or losing consciousness.",
            "reference_indexes": [
              2,
              8
            ]
          },
          {
            "snippet": "High potassium levels (Hyperkalemia): Symptoms include muscle weakness, fatigue, or a slow/irregular heartbeat.",
            "reference_indexes": [
              8,
              9
            ]
          },
          {
            "snippet": "Worsening kidney function: Decreased urination or unexplained swelling in your hands, ankles, or feet."
          }
        ],
        "reference_indexes": [
          2,
          8
        ]
      },
      {
        "type": "heading",
        "snippet": "Important Warnings & Precautions"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Pregnancy: Losartan must be used during pregnancy because it can cause serious harm or death to an unborn baby.",
            "reference_indexes": [
              0,
              10
            ]
          },
          {
            "snippet": "Medication Interactions: Avoid combining losartan with potassium supplements, salt substitutes containing potassium, aliskiren (if you have diabetes), or regular use of NSAIDs (like ibuprofen) without talking to your doctor.",
            "reference_indexes": [
              0,
              1
            ]
          },
          {
            "snippet": "Official Safety Information: You can review detailed prescribing information via the FDA Cozaar Labeling or check out guidance on Losartan for Women 40-50 via Ubie Health .",
            "snippet_links": [
              {
                "text": "FDA Cozaar Labeling",
                "link": "https://www.accessdata.fda.gov/drugsatfda_docs/label/2006/020386s043s046pi.pdf"
              },
