        "snippet": "When to Prioritize Each Class"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Choose an SGLT2 Inhibitor if: The patient has a history of heart failure (especially with reduced ejection fraction) or chronic kidney disease, or prefers a daily pill over injections.",
            "reference_indexes": [
              2
            ]
          },
          {
            "snippet": "Choose a GLP-1 Receptor Agonist if: The patient needs strong glycemic control, substantial weight loss, or has a high risk of stroke or atherosclerotic cardiovascular disease, and is comfortable with weekly injections.",
