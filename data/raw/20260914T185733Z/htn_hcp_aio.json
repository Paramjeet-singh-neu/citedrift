      {
        "type": "heading",
        "snippet": "Shared Safety & Cautions"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Potassium: Both can cause high potassium (hyperkalemia) and raise serum creatinine."
          },
          {
            "snippet": "Pregnancy: Strictly contraindicated (do not use in pregnancy)."
          },
          {
            "snippet": "Combination: Do not combine ACE inhibitors and ARBs together."
          },
          {
            "snippet": "Renal Artery: Avoid in bilateral renal artery stenosis."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Clinical Guidance"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Start with an ACE inhibitor or ARB (plus a calcium channel blocker or thiazide diuretic if needed for multi-drug control)."
          },
          {
            "snippet": "Switch from an ACE inhibitor to an ARB if a persistent dry cough or intolerance develops ."
          },
          {
            "snippet": "Review details via the National Kidney Foundation .",
            "snippet_links": [
              {
                "text": "National Kidney Foundation",
                "link": "https://www.kidney.org/kidney-topics/ace-inhibitors-and-arbs"
              }
            ]
          }
        ]
      },
