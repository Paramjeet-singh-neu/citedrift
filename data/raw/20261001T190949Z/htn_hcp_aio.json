      {
        "type": "paragraph",
        "snippet": "ACE inhibitors and angiotensin receptor blockers (ARBs) are equally recommended as first-line (initial) treatments for high blood pressure in major clinical guidelines.",
        "snippet_highlighted_words": [
          "ACE inhibitors and angiotensin receptor blockers (ARBs) are equally recommended as first-line (initial) treatments for high blood pressure in major clinical guidelines"
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Effectiveness"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Blood pressure reduction: Both drug classes lower blood pressure effectively by blocking the renin-angiotensin system (the body's hormone system that controls blood pressure and fluid balance).",
            "reference_indexes": [
              0
            ]
          },
          {
            "snippet": "Cardiovascular and kidney outcomes: Large head-to-head studies show no significant difference between ACE inhibitors and ARBs in preventing major heart attacks, strokes, or heart failure."
          }
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Safety and Tolerability"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Side effects: ARBs are generally better tolerated than ACE inhibitors.",
            "reference_indexes": [
              1
            ]
          },
          {
            "snippet": "Cough and swelling: ACE inhibitors raise levels of a peptide called bradykinin, which frequently causes a persistent dry cough and can rarely cause dangerous tissue swelling (angioedema). ARBs do not affect bradykinin, making these side effects much less common.",
            "reference_indexes": [
              1,
              2,
              3
            ]
          },
          {
            "snippet": "Preference: Because they offer a safer profile with fewer discontinuations, recent large-scale real-world analyses support preferentially prescribing ARBs over ACE inhibitors when starting new treatment."
          }
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Important Precautions"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Never combine them: You should never take an ACE inhibitor and an ARB together . Combining them increases the risk of high potassium (hyperkalemia) and kidney damage without providing extra heart benefits."
          },
          {
            "snippet": "Pregnancy: Both ACE inhibitors and ARBs can cause severe harm to an unborn baby and must be avoided during pregnancy."
          }
        ],
        "reference_indexes": [
          4,
          5,
          6
        ]
      },
