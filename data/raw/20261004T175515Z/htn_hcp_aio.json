  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "ACE inhibitors and ARBs (angiotensin II receptor blockers) are both considered effective first-line treatments for high blood pressure, but generally cause fewer side effects.",
        "snippet_highlighted_words": [
          "generally cause fewer side effects"
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Efficacy and Cardiovascular Outcomes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Equal effectiveness: Large-scale studies and reviews show that ACE inhibitors and ARBs lower blood pressure and prevent major cardiovascular events (like heart attack and stroke) with similar frequency.",
            "snippet_links": [
              {
                "text": "ACE inhibitors",
                "link": "https://www.mayoclinic.org/diseases-conditions/high-blood-pressure/in-depth/ace-inhibitors/art-20047480"
              },
              {
                "text": "ARBs",
                "link": "https://www.tctmd.com/news/time-guidelines-recommend-arbs-over-ace-inhibitors"
              }
            ]
          },
          {
            "snippet": "Historical track record: ACE inhibitors (ending in \"-pril\" like lisinopril) have been studied longer and have a larger body of older trial data.",
            "reference_indexes": [
              1,
              2
            ]
          },
          {
            "snippet": "Guideline preference shift: While older guidelines historically favored ACE inhibitors first, newer expert consensus and large safety data suggest (ending in \"-sartan\" like losartan) are often preferred initially due to better patient tolerance."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Side Effects and Tolerability"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Dry cough: Occurs significantly more often with ACE inhibitors (due to bradykinin buildup) than with ARBs."
          },
          {
            "snippet": "Angioedema: Serious deep tissue swelling is a rare but higher risk with ACE inhibitors compared to ARBs."
          },
          {
            "snippet": "Switching options: If a patient develops a persistent cough or angioedema on an ACE inhibitor , clinicians frequently switch them safely to an ARB."
          }
        ],
        "reference_indexes": [
          3,
          4
        ]
      },
