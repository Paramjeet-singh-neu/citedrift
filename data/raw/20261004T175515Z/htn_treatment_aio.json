    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "High blood pressure (hypertension) is treated using a combination of heart-healthy lifestyle changes and, when necessary, prescription medications tailored to your readings and overall risk.",
        "snippet_highlighted_words": [
          "heart-healthy lifestyle changes and, when necessary, prescription medications tailored to your readings and overall risk"
        ],
        "reference_indexes": [
          0,
          1,
          2
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifestyle Changes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "DASH Diet: Eat a diet rich in fruits, vegetables, whole grains, and low-fat dairy while reducing saturated fats ."
          },
          {
            "snippet": "Sodium Reduction: Limit daily salt intake to under 2,300 mg, with an ideal target of less than 1,500 mg per day."
          },
          {
            "snippet": "Regular Exercise : Engage in at least 30 minutes of moderate aerobic activity (like brisk walking or cycling) most days of the week."
          },
          {
            "snippet": "Weight Management: Lose extra body weight, as even a modest 5% weight loss can significantly lower blood pressure ."
          },
          {
            "snippet": "Limit Alcohol and Quit Smoking: Restrict alcohol to no more than one drink daily for women and two for men, and stop smoking to reduce heart disease risks."
          }
        ],
        "reference_indexes": [
          0,
          1,
          3,
          4,
          5,
          6
        ]
      },
      {
        "type": "heading",
        "snippet": "Common Medications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Thiazide Diuretics: Water pills that help your kidneys remove excess sodium and water from the body ."
          },
          {
            "snippet": "ACE Inhibitors and ARBs: Medications that relax blood vessels by preventing the formation or action of natural chemicals that narrow them."
          },
          {
            "snippet": "Calcium Channel Blockers : Drugs that prevent calcium from entering heart and blood vessel cells to help relax blood vessels."
          },
          {
            "snippet": "Beta-Blockers: Treatments that reduce the workload on the heart by slowing down the heart rate (often used as a secondary option) ."
          }
        ],
        "reference_indexes": [
          7,
          8,
          9,
          10
        ]
      },
      {
        "type": "paragraph",
        "snippet": "To help tailor this information, could you share:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "What your recent blood pressure readings have been?"
          },
          {
            "snippet": "Whether you are currently taking any blood pressure medications or experiencing other health conditions like diabetes or kidney disease?"
          }
        ]
      }
