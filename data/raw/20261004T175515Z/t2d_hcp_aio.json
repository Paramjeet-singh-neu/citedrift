      {
        "type": "heading",
        "snippet": "\u2705 When to Choose SGLT2 Inhibitors First"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "\ud83e\udec0 Heart Failure: Proven reduction in heart failure exacerbations and related hospitalizations."
          },
          {
            "snippet": "\ud83d\udebb Chronic Kidney Disease (CKD): Strongly slows renal function decline and diabetic nephropathy."
          },
          {
            "snippet": "\ud83d\udc8a Preference for Pills: Taken once daily as an oral tablet rather than an injection."
          }
        ],
        "reference_indexes": [
          6,
          7,
          8,
          9
        ]
      },
      {
        "type": "heading",
        "snippet": "\u2705 When to Choose GLP-1 Receptor Agonists First"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "\ud83d\udcc9 Higher A1C Reduction: More potent glucose-lowering capability when blood sugar numbers are significantly elevated."
          },
          {
            "snippet": "\u2696\ufe0f Pronounced Obesity: Preferred when substantial weight loss is a core therapeutic target."
          },
          {
            "snippet": "\ud83e\udde0 Atherosclerotic CVD: Highly effective at preventing major adverse cardiovascular events like stroke and myocardial infarction ."
          }
        ],
        "reference_indexes": [
          6,
          7,
          8,
          9,
          10
        ]
      },
