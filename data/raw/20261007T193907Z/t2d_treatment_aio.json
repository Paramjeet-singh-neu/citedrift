  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Type 2 diabetes treatment involves lifestyle adjustments, oral and injectable medications, and surgical options to manage blood sugar levels.",
        "snippet_highlighted_words": [
          "lifestyle adjustments, oral and injectable medications, and surgical options"
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifestyle Changes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Healthy Eating: Focus on non-starchy vegetables, lean proteins, and complex carbohydrates while limiting processed foods and added sugars.",
            "reference_indexes": [
              1,
              2
            ]
          },
          {
            "snippet": "Physical Activity: Aim for at least 150 minutes of aerobic and strength exercise per week to lower blood sugar and improve insulin sensitivity.",
            "reference_indexes": [
              0,
              2
            ]
          },
          {
            "snippet": "Weight Management: Strive for modest weight loss (5% or more of body weight) to ease insulin resistance."
          }
        ],
        "reference_indexes": [
          0
        ]
      },
      {
        "type": "heading",
        "snippet": "Oral Medications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Metformin (Biguanide): The standard first-line medication that lowers glucose production in the liver and improves muscle insulin sensitivity.",
            "reference_indexes": [
              0,
              3
            ]
          },
          {
            "snippet": "SGLT2 Inhibitors: Drugs like empagliflozin, dapagliflozin, and canagliflozin help the kidneys remove extra glucose through urine and benefit heart and kidney health.",
            "reference_indexes": [
              4,
              5
            ]
          },
          {
            "snippet": "DPP-4 Inhibitors: Medications like sitagliptin and linagliptin help keep blood sugar down without causing weight gain or low blood sugar (hypoglycemia).",
            "reference_indexes": [
              4,
              5
            ]
          },
          {
            "snippet": "Sulfonylureas & Meglitinides: Drugs like glipizide or glimepiride trigger the pancreas to release more insulin.",
            "reference_indexes": [
              4,
              5
            ]
          },
          {
            "snippet": "Thiazolidinediones (TZDs): Pioglitazone and rosiglitazone improve insulin sensitivity in body tissues.",
            "reference_indexes": [
              4,
              5
            ]
          },
          {
            "snippet": "Alpha-Glucosidase Inhibitors: Acarbose and miglitol slow down the breakdown of starches in the gut."
          }
        ],
        "reference_indexes": [
          4,
          5
        ]
      },
      {
        "type": "heading",
        "snippet": "Injectable Medications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "GLP-1 Receptor Agonists & GIP/GLP-1 Agonists: Medications like semaglutide, dulaglutide, liraglutide, and tirzepatide stimulate meal-time insulin, slow digestion, and frequently aid with weight loss and heart protection ."
          },
          {
            "snippet": "Insulin Therapy: Used when other medications no longer control blood sugar adequately; administered via pens, syringes, or pumps (ranging from long-acting to rapid-acting types)."
          }
        ],
        "reference_indexes": [
          4,
          6,
          7,
          8
        ]
      },
      {
        "type": "heading",
        "snippet": "Surgical Options"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Bariatric (Weight-Loss) Surgery: A procedure like gastric bypass or a duodenal switch can significantly reduce or reverse type 2 diabetes in qualifying individuals with a high BMI ."
          }
        ],
        "reference_indexes": [
          0,
          9
        ]
      },
