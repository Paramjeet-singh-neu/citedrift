    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "The primary initial symptom of pulmonary arterial hypertension (PAH) is severe shortness of breath during physical exertion, which gradually worsens until it occurs even at rest.",
        "snippet_highlighted_words": [
          "severe shortness of breath during physical exertion"
        ],
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "paragraph",
        "snippet": "PAH is a serious condition where the blood vessels in the lungs narrow or block, making the right side of the heart work much harder to pump blood. Because these signs mimic other heart and lung issues, they often develop slowly and can be easily missed early on.",
        "reference_indexes": [
          2,
          3
        ]
      },
      {
        "type": "heading",
        "snippet": "Common Symptoms"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Shortness of breath (dyspnea): Starts during exercise or climbing stairs, eventually happening while resting."
          },
          {
            "snippet": "Fatigue and weakness: A deep tiredness that does not improve with sleep or rest."
          },
          {
            "snippet": "Dizziness or lightheadedness: Often triggered by physical activity."
          },
          {
            "snippet": "Fainting (syncope): Passing out during exertion due to reduced blood flow to the brain."
          },
          {
            "snippet": "Chest pain or pressure: Discomfort caused by an overworked and strained heart muscle."
          },
          {
            "snippet": "Heart palpitations: A sensation that your heart is racing, fluttering, or beating irregularly."
          },
          {
            "snippet": "Swelling (edema): Fluid buildup causing swelling in the ankles, legs, feet, or abdomen, which indicates right-sided heart strain."
          },
          {
            "snippet": "Cyanosis: A bluish or grayish tint to the lips and skin caused by low oxygen levels in the blood."
          }
        ],
        "reference_indexes": [
          0,
          1,
          3,
          4,
          5,
          6,
          7,
          8,
          9,
          10
        ]
      },
      {
        "type": "heading",
        "snippet": "Advanced Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Cough: Occasionally producing blood (hemoptysis)."
          },
          {
            "snippet": "Horaseness: Caused when an enlarged pulmonary artery presses on a nerve in the chest."
          },
          {
            "snippet": "Abdominal discomfort: Pain or swelling in the upper right side of the belly due to an enlarged liver."
          }
        ],
        "reference_indexes": [
          0,
          1,
          4,
          5
        ]
      },
      {
