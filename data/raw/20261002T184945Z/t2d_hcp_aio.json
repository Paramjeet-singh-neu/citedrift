      {
        "type": "heading",
        "snippet": "\ud83d\udcc9 SGLT2 Inhibitor Profile"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How it works: Blocks renal glucose reabsorption to pass sugar through urine."
          },
          {
            "snippet": "Best for : Patients with coexisting heart failure or chronic kidney disease."
          },
          {
            "snippet": "Financial/Hidden cost: Generics available (lower cost), monitor for volume depletion."
          }
        ],
        "reference_indexes": [
          5,
          6,
          7
        ]
      },
      {
        "type": "heading",
        "snippet": "\ud83d\udcc8 GLP-1 Receptor Agonist Profile"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "How it works: Stimulates insulin secretion and slows gastric emptying."
          },
          {
            "snippet": "Best for : Patients needing major weight loss or high cardiovascular risk reduction."
          },
          {
            "snippet": "Financial/Hidden cost: High brand-name costs, potential supply shortages, and strict insurance prior authorizations."
          }
        ],
