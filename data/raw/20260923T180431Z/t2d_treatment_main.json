  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Type 2 diabetes treatment relies on a combination of lifestyle changes, routine blood sugar monitoring, and medications tailored by your healthcare team.",
        "snippet_highlighted_words": [
          "lifestyle changes, routine blood sugar monitoring, and medications tailored by your healthcare team"
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifestyle Interventions"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Healthy Eating: Focus on a balanced meal plan rich in non-starchy vegetables, lean proteins, and complex carbohydrates created alongside a dietitian."
          },
          {
            "snippet": "Regular Physical Activity: Aim for at least 150 minutes of moderate exercise each week, plus resistance training, to help lower blood sugar and improve insulin sensitivity."
          },
          {
            "snippet": "Weight Management: Safe weight loss can improve blood sugar control and overall metabolic health."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Oral Medications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Metformin: Commonly prescribed as the first-line oral medication; it works by reducing glucose production in the liver and improving insulin sensitivity.",
            "snippet_links": [
              {
                "text": "Metformin",
                "link": "https://www.mayoclinic.org/diseases-conditions/type-2-diabetes/diagnosis-treatment/drc-20351199"
              }
            ]
          },
          {
            "snippet": "Sulfonylureas: (e.g., glipizide, glyburide) Stimulate the pancreas to produce more insulin."
          },
          {
            "snippet": "SGLT2 Inhibitors: Help the kidneys remove extra sugar through the urine and offer protective benefits for the heart and kidneys."
          },
          {
            "snippet": "DPP-4 Inhibitors: Help lower blood glucose by prolonging the activity of helpful digestive chemicals."
          },
          {
            "snippet": "Thiazolidinediones (TZDs): Improve insulin sensitivity in muscle and fat cells."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Injectable Medications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "GLP-1 Receptor Agonists / Dual GIP/GLP-1 Agonists: (e.g., Ozempic, Victoza) Injectable options that stimulate insulin release, slow digestion, suppress appetite, and support weight loss."
          },
          {
            "snippet": "Insulin Therapy: Used when oral and other injectable options are not enough to meet target glucose levels, delivered via pens, syringes, or pumps."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Consult your doctor or review guidance from the American Diabetes Association to build a personalized treatment plan.",
        "snippet_links": [
          {
            "text": "American Diabetes Association",
            "link": "https://diabetes.org/"
          }
        ]
      }
    ],
