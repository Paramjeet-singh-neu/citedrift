  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Early signs of type 2 diabetes include increased thirst, frequent urination, and constant fatigue.",
        "snippet_highlighted_words": [
          "increased thirst, frequent urination, and constant fatigue"
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Because the symptoms develop slowly, many people do not notice them at first. You can learn more about warning signs through the American Diabetes Association.",
        "snippet_links": [
          {
            "text": "American Diabetes Association",
            "link": "https://diabetes.org/about-diabetes/warning-signs-symptoms"
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Common Early Signs"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Increased thirst and frequent urination: High blood sugar forces your kidneys to work harder to remove extra sugar, which makes you urinate more often and feel very thirsty."
          },
          {
            "snippet": "Constant fatigue: Your cells cannot absorb glucose properly for energy, leaving you feeling tired even after resting."
          },
          {
            "snippet": "Increased hunger: You may feel hungry shortly after eating because your body's cells are not getting the energy they need from the food."
          },
          {
            "snippet": "Blurred vision: High blood sugar can change the fluid levels and shape of the lenses in your eyes."
          },
          {
            "snippet": "Slow-healing cuts or sores: Elevated blood sugar impairs blood flow and your immune system, making minor wounds take longer to heal."
          },
          {
            "snippet": "Frequent infections: High glucose levels encourage bacteria and yeast to grow, leading to regular urinary tract or yeast infections."
          },
          {
            "snippet": "Tingling or numbness: Nerve irritation or damage can cause a pins-and-needles feeling in your hands or feet."
          },
          {
            "snippet": "Darkened skin patches: Velvety, dark skin folds (acanthosis nigricans) on the neck or armpits can signal insulin resistance."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "What to Do Next"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "See a doctor: Blood tests, such as a fasting glucose or A1C test, are required to confirm a diagnosis."
          },
          {
            "snippet": "Focus on healthy habits: Eating balanced meals with fiber and exercising regularly help improve how your body handles insulin."
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you want to check your symptoms or understand your risk factors further, you can read more detailed guides from the Cleveland Clinic or review the Mayo Clinic Overview.",
        "snippet_links": [
          {
            "text": "Cleveland Clinic",
            "link": "https://my.clevelandclinic.org/health/diseases/21501-type-2-diabetes"
          },
          {
            "text": "Mayo Clinic Overview",
            "link": "https://www.mayoclinic.org/diseases-conditions/type-2-diabetes/symptoms-causes/syc-20351193"
          }
        ]
      }
