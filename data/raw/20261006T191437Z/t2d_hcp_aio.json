      {
        "type": "heading",
        "snippet": "\u2705 When to Choose SGLT2 Inhibitors"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "You have diagnosed heart failure (with reduced or preserved ejection fraction)."
          },
          {
            "snippet": "You have active chronic kidney disease (CKD) or high risk for renal decline."
          },
          {
            "snippet": "You strongly prefer taking a daily oral pill over an injectable medication."
          }
        ],
        "reference_indexes": [
          0,
          2,
          3,
          4
        ]
      },
      {
        "type": "heading",
        "snippet": "\u2705 When to Choose GLP-1 Receptor Agonists"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Your primary goals include significant weight loss and obesity management."
          },
          {
            "snippet": "You have high risk or established atherosclerotic cardiovascular disease (ASCVD) or history of stroke."
          },
          {
            "snippet": "You need a more potent reduction in blood glucose/A1C levels."
          }
        ],
