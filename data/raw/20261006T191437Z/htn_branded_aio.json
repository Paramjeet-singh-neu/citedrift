      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Angioedema (severe allergic reaction causing swelling of the face, lips, tongue, or throat)."
          },
          {
            "snippet": "High potassium levels (hyperkalemia), which can cause muscle weakness or an irregular heartbeat ."
          },
          {
            "snippet": "Kidney problems indicated by a dramatic decrease in urination or swelling in the hands and feet."
          },
          {
            "snippet": "Severe low blood pressure leading to fainting or extreme dizziness."
          },
          {
