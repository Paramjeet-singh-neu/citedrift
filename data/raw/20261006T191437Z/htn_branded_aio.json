        "type": "heading",
        "snippet": "Common and Mild Side Effects"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Dizziness or lightheadedness from lowered blood pressure, especially when standing up quickly."
          },
          {
            "snippet": "Fatigue or feeling more tired than usual."
          },
          {
            "snippet": "Upper respiratory symptoms like a stuffy nose, sneezing, or a sore throat."
          },
          {
            "snippet": "Digestive issues such as mild diarrhea, nausea, or upset stomach."
          },
          {
            "snippet": "Back or joint pain and muscle cramps."
          },
          {
            "snippet": "Headache during the first couple of weeks."
          }
        ],
