  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Type 2 diabetes treatment involves lifestyle adjustments, oral or injectable medications, and regular monitoring.",
        "snippet_highlighted_words": [
          "lifestyle adjustments, oral or injectable medications"
        ],
        "reference_indexes": [
          0,
          1
        ]
      },
      {
        "type": "heading",
        "snippet": "Lifestyle Changes"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Healthy Eating: Focus on non-starchy vegetables, lean proteins, healthy fats, and complex carbohydrates while limiting processed foods and added sugars ."
          },
          {
            "snippet": "Physical Activity: Aim for at least 150 minutes of aerobic and strength exercise per week to improve insulin sensitivity and lower blood sugar."
          },
          {
            "snippet": "Weight Management: Losing 5% or more of your body weight helps lower blood sugar and reduce cardiometabolic risks."
          }
        ],
        "reference_indexes": [
          2
        ]
      },
      {
        "type": "heading",
        "snippet": "Medications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Metformin: The most common first-line oral medication, which decreases glucose production in the liver and improves muscle insulin sensitivity.",
            "reference_indexes": [
              3
            ]
          },
          {
            "snippet": "SGLT2 Inhibitors: Oral pills (such as empagliflozin or dapagliflozin) that help the kidneys remove excess sugar through urine and protect heart and kidney health.",
            "reference_indexes": [
              4
            ]
          },
          {
            "snippet": "GLP-1 Receptor Agonists (and Dual Agonists): Injectable (or oral) medications (such as semaglutide or tirzepatide) that help release insulin, slow digestion, suppress appetite, and reduce heart risks."
          },
          {
            "snippet": "Sulfonylureas & Meglitinides: Oral pills that stimulate the pancreas to produce more insulin.",
            "reference_indexes": [
              5
            ]
          },
          {
            "snippet": "DPP-4 Inhibitors: Oral pills that help keep blood sugar down without causing weight gain or low blood sugar."
          },
          {
            "snippet": "Thiazolidinediones (TZDs): Oral pills that improve insulin sensitivity in fat and muscle tissue.",
            "reference_indexes": [
              6
            ]
          },
          {
            "snippet": "Insulin Therapy: Injectable synthetic insulin used if other medications do not keep blood sugar under control."
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Other Options"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Coexisting Condition Care: Medications like statins or blood pressure drugs are frequently prescribed to lower heart disease and stroke risks."
          },
          {
            "snippet": "Bariatric Surgery: Weight-loss surgery may be considered for qualifying body mass indices (BMIs) to help improve or remit type 2 diabetes."
          }
        ],
        "reference_indexes": [
          7
        ]
      },
      {
        "type": "paragraph",
        "snippet": "For detailed guidance from the American Diabetes Association or the Mayo Clinic , speak with a healthcare provider to build a personalized plan.",
        "snippet_links": [
