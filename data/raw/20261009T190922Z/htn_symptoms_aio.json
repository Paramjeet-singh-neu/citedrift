    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "High blood pressure (hypertension) is usually a \"silent killer\" because it rarely causes any noticeable signs or symptoms for years. Most people feel completely fine even when their numbers are dangerously high.",
        "snippet_highlighted_words": [
          "rarely causes any noticeable signs or symptoms for years"
        ],
        "reference_indexes": [
          0,
          1,
          2
        ]
      },
      {
        "type": "heading",
        "snippet": "The Only Reliable Sign"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "A blood pressure cuff reading: The only way to know if you have high blood pressure is to measure it using a blood pressure monitor."
          },
          {
            "snippet": "Normal reading: Less than 120/80 mm Hg."
          },
          {
            "snippet": "High blood pressure (Stage 1 or higher): 130/80 mm Hg or higher."
          }
        ],
        "reference_indexes": [
          0,
          3,
          4,
          5
        ]
      },
      {
        "type": "heading",
        "snippet": "Symptoms of a Hypertensive Crisis (Emergency)"
      },
      {
        "type": "paragraph",
        "snippet": "When blood pressure spikes to extremely dangerous levels (typically above 180/120 mm Hg), it can cause acute organ damage. Call 911 immediately if these symptoms appear along with a very high reading:",
        "reference_indexes": [
          0,
          2,
          5
        ]
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Severe, sudden headache"
          },
          {
            "snippet": "Chest pain or tightness"
          },
          {
            "snippet": "Shortness of breath or difficulty breathing"
          },
          {
            "snippet": "Sudden vision changes (blurry or double vision)"
          },
          {
            "snippet": "Confusion, dizziness, or severe fatigue"
          },
          {
            "snippet": "Numbness, weakness, or signs of a stroke (such as facial drooping or slurred speech)"
          },
          {
            "snippet": "Frequent or heavy nosebleeds"
          }
        ],
        "reference_indexes": [
          2,
          6,
          7,
          8,
          9,
          10
        ]
      },
      {
        "type": "paragraph",
        "snippet": "Learn more about tracking your numbers and guidelines from the American Heart Association or the Centers for Disease Control and Prevention .",
        "snippet_links": [
          {
            "text": "American Heart Association",
            "link": "https://www.heart.org/en/health-topics/high-blood-pressure/the-facts-about-high-blood-pressure"
          },
          {
            "text": "Centers for Disease Control and Prevention",
            "link": "https://www.cdc.gov/high-blood-pressure/about/index.html"
          }
        ],
        "reference_indexes": [
          3,
          5
        ]
      },
      {
        "type": "paragraph",
        "snippet": "If you'd like, let me know:"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "What was your most recent blood pressure reading?"
          },
          {
            "snippet": "Are you experiencing any specific symptoms right now?"
          }
        ]
      }
